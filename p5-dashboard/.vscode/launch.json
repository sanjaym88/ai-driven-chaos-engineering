{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "P5: Dashboard (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "P5: Slack notifier (worker)",
      "type": "debugpy",
      "request": "launch",
      "module": "p5",
      "args": ["worker"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "P5: Simulate a live run",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/simulate_run.py",
      "args": ["--outcome", "aborted"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "P5: Build all reports",
      "type": "debugpy",
      "request": "launch",
      "module": "p5",
      "args": ["report", "--all"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
